/*
 * German (QWERTZ) keymap for a 42-key Corne, ZMK v0.3
 *
 * Requirements:
 *   - config/keys_de.h from the ZMK locale headers (German)
 *   - your operating system set to the German (Germany) keyboard layout
 *
 * Letters, digits, umlauts and ß use the DE_ names from keys_de.h.
 * Symbols use plain ZMK key codes (comments show the character you get on a
 * German OS layout), so they don't depend on names inside the header.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    /* Hold LOWER + RAISE together to get ADJUST (Bluetooth, Studio, bootloader) */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        /* Tap = letter, double tap = umlaut */
        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_A>, <&kp DE_A_UMLAUT>;
        };

        td_o: tap_dance_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_O>, <&kp DE_O_UMLAUT>;
        };

        /* Double tap q = @ (AltGr + Q on a German layout) */
        td_q: tap_dance_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_Q>, <&kp RA(Q)>;
        };

        td_u: tap_dance_u {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_U>, <&kp DE_U_UMLAUT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp TAB     &td_q     &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T      &kp DE_Z  &td_u     &kp DE_I      &td_o             &kp DE_P          &kp ESC
&kp LCTRL   &td_a     &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G      &kp DE_H  &kp DE_J  &kp DE_K      &kp DE_L          &kp DE_SZ         &kp ESC
&kp LSHFT   &kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B      &kp DE_N  &kp DE_M  &kp COMMA     &kp DOT           &kp FSLH          &kp RAISE
                              &kp LGUI  &mo SPACE  &kp LOWER      &kp RET   &mo BSPC &kp BSPC
            >;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
&kp ESC     &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5      &kp DE_N6  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_N0  &kp BSPC
&trans      &none      &none      &none      &none      &none         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none      &none
&trans      &none      &none      &none      &none      &none         &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none      &trans
                                  &trans     &trans     &trans        &kp DEL    &trans     &trans
            >;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
&trans      &kp EXCL      &kp LS(N2)    &kp LS(N3)    &kp LS(N4)     &kp LS(N5)       &kp LS(N6)      &kp LS(N7)      &kp LS(N8)      &kp LS(N9)   &kp LS(N0)    &kp LS(MINUS)
&trans      &kp RA(Q)     &kp RA(E)     &kp RA(N7)    &kp RA(N8)     &kp RA(N9)       &kp RA(N0)      &kp RA(MINUS)   &kp RA(NUBS)    &kp NUHS     &kp LS(NUHS)  &kp RA(RBKT)
&trans      &kp NUBS      &kp LS(NUBS)  &kp RBKT      &kp LS(RBKT)   &kp FSLH         &kp LS(FSLH)    &kp LS(COMMA)   &kp LS(DOT)     &none        &none         &trans
                                        &trans        &trans         &trans           &trans          &trans          &trans
            >;
            /*
             * Row 1: ! " § $ % & / ( ) = ?
             * Row 2: @ € { [ ] } \ | # ' ~
             * Row 3: < > + * -  _ ; :
             */
        };

        adjust_layer {
            label = "ADJUST";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &studio_unlock  &none  &none  &none  &none  &bootloader
&none       &none         &none         &none         &none         &none             &none           &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none             &none           &none  &none  &none  &none  &none
                                        &none         &none         &none             &none           &none  &none
            >;
        };
    };
};
