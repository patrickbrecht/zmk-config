/*
 * German (QWERTZ) keymap for a 42-key Corne, ZMK v0.3
 *
 * Requirements:
 *   - config/keys_de.h from the ZMK locale headers (German)
 *   - your operating system set to the German (Germany) keyboard layout
 *
 * Letters, digits, umlauts and ß use the DE_ names from keys_de.h.
 * Symbols use plain ZMK key codes (comments show the character you get on a
 * German OS layout), so they don't depend on names inside the header.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    /* Hold LOWER + RAISE together to get ADJUST (Bluetooth, Studio, bootloader) */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        /* Tap = letter, double tap = umlaut */
        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_A>, <&kp DE_A_UMLAUT>;
        };

        td_o: tap_dance_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_O>, <&kp DE_O_UMLAUT>;
        };

        /* Double tap q = @ (AltGr + Q on a German layout) */
        td_q: tap_dance_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_Q>, <&kp RA(Q)>;
        };

        td_u: tap_dance_u {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_U>, <&kp DE_U_UMLAUT>;
        };

        td_sl: tap_dance_sl {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp RA(MINUS)>, <&kp LS(N7)>;
        };

        td_cm: tap_dance_cm {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp COMMA>, <&kp LS(COMMA)>;
        };

        td_dot: tap_dance_dot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DOT>, <&kp LS(DOT)>;
        };

        td_apos: tap_dance_apos {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LS(NUHS)>, <&kp LS(N2)>;
        };

        td_hyph: tap_dance_hyph {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp FSLH>, <&kp LS(FSLH)>;
        };

        td_eur: tap_dance_eur {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_E>, <&kp RA(E)>;
        };

        td_sz: tap_dance_sz {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp DE_S>, <&kp DE_SZ>;
        };

        td_eq: tap_dance_eq {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LS(N0)>, <&kp RA(RBKT)>;        /* =  ~  */
        };

        td_dollar: tap_dance_dollar {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LS(N4)>, <&kp LS(N3)>;          /* $  §  */
        };

        td_lt: tap_dance_lt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp NUBS>, <&kp LS(NUBS)>;          /* <  >  */
        };

        td_caret: tap_dance_caret {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp GRAVE>, <&kp RA(RBKT)>;         /* ^  ~  (^ is a dead key) */
        };

        td_grave: tap_dance_grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LS(EQUAL)>, <&kp EQUAL>;        /* `  ´  (dead keys) */
        };

        td_pm: tap_dance_pm {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp RBKT>, <&kp FSLH>;        /* `  ´  (dead keys) */
        };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC     &td_q     &kp DE_W  &td_eur   &kp DE_R  &kp DE_T      &td_sl  &td_u     &kp DE_I      &td_o       &kp DE_P    &kp ESC
&kp LCTRL   &td_a     &td_sz    &kp DE_D  &kp DE_F  &kp DE_G      &td_cm  &kp DE_H  &kp DE_J      &kp DE_K    &kp L       &kp ESC
&kp LSHFT   &kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B      &td_apos  &kp DE_N  &kp DE_M    &td_hyph    &td_dot     &mo RAISE
                              &kp LGUI  &kp SPACE  &mo LOWER      &kp RET   &kp BSPC  &mo ADJUST
            >;
        };

        lower_layer {
            label = "BrdSys";
            bindings = <
&trans      &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5      &kp DE_N6     &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_N0  &kp DEL
&trans      &none      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_MUTE      &none         &kp LEFT   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT    &none
&trans      &none      &kp C_PREV      &kp C_NEXT      &kp C_STOP      &kp C_PLAY    &td_cm  &kp HOME   &kp PG_DN  &kp PG_UP  &kp END      &trans
                                &kp LGUI     &kp SPACE     &trans      &kp RET    &kp BSPC     &mo ADJUST
            >;
        };

        raise_layer {
            label = "SymNum";
            bindings = <
&trans      &kp EXCL      &kp LS(MINUS)  &kp RA(N7)   &kp RA(N0)   &kp RA(NUBS)      &td_sl      &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp LS(RBKT)  &kp F12
&trans      &kp NUHS      &td_dollar     &kp LS(N8)   &kp LS(N9)   &td_grave         &td_apos    &kp DE_N4  &kp DE_N5  &kp DE_N6  &td_pm      &td_caret
&trans      &kp LS(N5)    &td_lt         &kp RA(N8)   &kp RA(N9)   &kp LS(N6)        &td_eq      &kp DE_N1  &kp DE_N2  &kp DE_N3  &td_dot       &to BASE
                                         &kp LGUI     &kp SPACE    &trans           &kp RET    &kp BSPC     &mo ADJUST
            >;
        };

        adjust_layer {
            label = "SysFunc";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &studio_unlock  &none  &none  &none  &none  &bootloader
&none       &none         &none         &none         &none         &none             &none           &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none             &none           &none  &none  &none  &none  &none
                                        &none         &none         &none             &none           &none  &none
            >;
        };
    };
};
